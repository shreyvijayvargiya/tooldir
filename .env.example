# .env.example
# Copy to .env.local and fill in values

# Site (required for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key

# Stripe (one-time launch-slot checkout)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Test mode: force $0 Checkout so you can complete payment + webhook DB updates without charging a card
STRIPE_TEST_ZERO=true
NEXT_PUBLIC_STRIPE_TEST_ZERO=true

# Email (optional — Resend receipt after webhook)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@yourdomain.com

# Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
